# URL pública del API Gateway (todas las peticiones pasan por él)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# true = el backend se simula en el navegador (para usar el frontend sin los microservicios)
NEXT_PUBLIC_DEMO_MODE=false
# true = el login muestra botones para entrar con las cuentas de ejemplo (útil para probar o presentar)
NEXT_PUBLIC_SHOW_TEST_ACCOUNTS=false
